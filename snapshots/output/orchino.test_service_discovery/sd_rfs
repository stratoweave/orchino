# === Layer 1 adata ===
# YANG module (prefix) and namespace:
#   orchino-rfs (orchino-rfs)  http://example.com/orchino-rfs
#   stratoweave-rfs (sw-rfs)   http://stratoweave.org/yang/stratoweave-rfs
# Top node: /
l1 = root()

# List /device (stratoweave-rfs) element: 'FRA'
device_element = l1.device.create('FRA', type='CiscoIosXr_24_1_ncs55a1')

# List /device[name='FRA']/address element: 'oob'
address_element = device_element.address.create('oob', address='FRA')

# Container: /device[name='FRA']/credentials
device_element.credentials.username = 'clab'
device_element.credentials.password = 'clab@123'

# List /rfs (stratoweave-rfs) element: 'FRA'
rfs_element = l1.rfs.create('FRA')

# List /rfs[name='FRA']/base-config (orchino-rfs) element: 'FRA'
base_config_element = rfs_element.base_config.create('FRA', ipv4_address='10.0.0.2')

# === Round-trip diff (per device) ===
